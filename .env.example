# Port for the API server (and the built web app in production).
PORT=8787
# SQLite database file. Created and migrated on first start.
DATABASE_PATH=data/open-mass-times.sqlite
# Raster tile URL for the map. The default is the OpenStreetMap Foundation tile
# server, which is fine for development but NOT for production traffic; see
# ROADMAP.md ("Production map tiles").
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
